{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "claudecode": ["rules", "skills", "subagents"],
    "codexcli": ["rules", "skills"],
    "cursor": ["rules", "skills"],
    "copilot": ["rules", "skills"],
    "claudecode-plugin": ["subagents", "skills"]
  },
  "outputRoots": {
    "claudecode": ".",
    "codexcli": ".",
    "cursor": ".",
    "copilot": ".",
    "claudecode-plugin": "./plugins/ai-skills"
  },
  "delete": true,
  "verbose": false,
  "silent": false,
  "global": false,
  "simulateCommands": false,
  "simulateSubagents": false,
  "simulateSkills": false,
  "gitignoreTargetsOnly": true
}
